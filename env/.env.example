# Copy this file to env/.env. Never commit the private copy.
# Use a long random password with URL-safe characters (hex is suitable).
POSTGRES_PASSWORD=
POSTGRES_USER=clips
POSTGRES_DB=clips
COMPOSE_PROJECT_NAME=vi-clips
WEB_PORT=3166
APP_BASE_URL=http://localhost:3166
WORKER_CONCURRENCY=2
FFMPEG_THREADS=1
WHISPER_MODEL=tiny
WHISPER_THREADS=1
WHISPER_BEAM_SIZE=1

# Optional: only needed for private cloud access / migration tools.
SSH_HOST=
SSH_USER=
SSH_IDENTITY_FILE=
SSH_KNOWN_HOSTS_FILE=
LOCAL_TUNNEL_PORT=4166
CLOUD_WEB_PORT=3166
VI_DEPLOY_ROOT=/opt/vi-clips
VI_COMPOSE_PROJECT=vi-clips-oci
